# Paper-only research build. Wallet keys and DRY_RUN=false are rejected.
DRY_RUN=true
MODEL=mock
# To use JEV, set MODEL=jev and put your key here locally. Never commit .env.
TYPESAFE_API_KEY=
JEV_MODEL_ID=jev-latest

RPC_URL=https://rpc.monad.xyz
READ_RPC_URL=https://rpc.monad.xyz
# Optional; HTTP polling works without a websocket.
WS_URL=

# Conservative research defaults. Confidence is not a profit guarantee.
TRADE_SIZE_MON=200
MAX_POSITION_MON=1000
BANKROLL_USD=100
QUOTE_INSIDE_TICKS=1
MIN_CONFIDENCE=0.65
MAX_SESSION_LOSS_USD=5
MAX_MODEL_CALLS=300
MAX_SPREAD_BPS=50
MAX_BOOK_LAG_BLOCKS=5
MAX_DECISION_MS=1000
DECISION_EVERY_BLOCKS=10
HORIZON_BLOCKS=100

HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=http://localhost:3001
